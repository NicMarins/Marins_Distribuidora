<%- include('partials/header') %>

<section class="container pagina-autenticacao">
  <div class="cartao-autenticacao">
    <h1>Redefinir senha</h1>
    <p class="pagina-autenticacao__subtitulo">Escolha uma nova senha para sua conta.</p>

    <% if (typeof erros !== 'undefined' && erros.length) { %>
      <ul class="lista-erros">
        <% erros.forEach(erro => { %>
          <li><%= erro.msg %></li>
        <% }) %>
      </ul>
    <% } %>

    <form action="/api/auth/redefinir-senha" method="POST" novalidate>
      <input type="hidden" name="_csrf" value="<%= csrfToken %>">
      <input type="hidden" name="token" value="<%= token %>">

      <div class="campo-formulario">
        <label for="nova-senha-redefinicao">Nova senha</label>
        <input type="password" id="nova-senha-redefinicao" name="senha" required minlength="8" autocomplete="new-password">
        <span class="dica-campo">Mínimo de 8 caracteres.</span>
      </div>

      <div class="campo-formulario">
        <label for="confirmar-senha-redefinicao">Confirmar nova senha</label>
        <input type="password" id="confirmar-senha-redefinicao" name="confirmarSenha" required minlength="8" autocomplete="new-password">
      </div>

      <button type="submit" class="botao botao--primario botao--largura-total">Redefinir senha</button>
    </form>
  </div>
</section>

<%- include('partials/footer') %>
