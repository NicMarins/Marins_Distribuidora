<%- include('partials/header') %>

<section class="container pagina-autenticacao">
  <div class="cartao-autenticacao">
    <h1>Criar conta</h1>
    <p class="pagina-autenticacao__subtitulo">Leva menos de um minuto.</p>

    <% if (typeof erros !== 'undefined' && erros.length) { %>
      <ul class="lista-erros">
        <% erros.forEach(erro => { %>
          <li><%= erro.msg %></li>
        <% }) %>
      </ul>
    <% } %>

    <form action="/api/auth/cadastro" method="POST" novalidate>
      <input type="hidden" name="_csrf" value="<%= csrfToken %>">
      <div class="campo-formulario">
        <label for="nome">Nome completo</label>
        <input type="text" id="nome" name="nome" required autocomplete="name">
      </div>

      <div class="campo-formulario">
        <label for="email-cadastro">E-mail</label>
        <input type="email" id="email-cadastro" name="email" required autocomplete="email">
      </div>

      <div class="campo-formulario">
        <label for="telefone">Telefone</label>
        <input type="tel" id="telefone" name="telefone" autocomplete="tel">
      </div>

      <div class="campo-formulario">
        <label for="senha-cadastro">Senha</label>
        <input type="password" id="senha-cadastro" name="senha" required autocomplete="new-password" minlength="8">
        <span class="dica-campo">Mínimo de 8 caracteres.</span>
      </div>

      <div class="campo-formulario">
        <label for="confirmar-senha">Confirmar senha</label>
        <input type="password" id="confirmar-senha" name="confirmarSenha" required autocomplete="new-password" minlength="8">
      </div>

      <button type="submit" class="botao botao--primario botao--largura-total">Criar conta</button>
    </form>

    <p class="pagina-autenticacao__rodape">
      Já tem conta? <a href="/login">Entrar</a>
    </p>
  </div>
</section>

<%- include('partials/footer') %>
