<%- include('partials/header') %>

<section class="container pagina-perfil">
  <h1>Meu Perfil</h1>

  <div class="layout-perfil">
    <aside class="menu-perfil">
      <div class="menu-perfil__avatar">
        <img src="<%= usuario.avatar_url || '/images/placeholder-avatar.svg' %>" alt="Foto de perfil" id="avatar-preview">
        <form id="form-avatar" action="/api/usuarios/avatar" method="POST" enctype="multipart/form-data">
          <input type="file" id="input-avatar" name="avatar" accept="image/png, image/jpeg, image/webp" style="display: none;">
        </form>
        <button type="button" class="link-discreto" id="botao-alterar-foto">Alterar foto</button>
      </div>
      <ul class="lista-filtros">
        <li><a href="#dados-pessoais" class="filtro-ativo">Dados pessoais</a></li>
        <li><a href="#seguranca">Segurança</a></li>
        <li><a href="#pedidos">Meus pedidos</a></li>
        <li><a href="/logout">Sair da conta</a></li>
      </ul>
    </aside>

    <div class="conteudo-perfil">
      <section id="dados-pessoais" class="cartao-perfurado" style="margin-bottom: 2rem;">
        <h2 style="font-size: 1.1rem;">Dados pessoais</h2>
        <p style="font-family: var(--fonte-mono); font-size: 0.8rem; color: var(--cor-tinta-suave);">
          Nível de acesso: <%= usuario.role %>
        </p>
        <% if (typeof erroPerfil !== 'undefined' && erroPerfil) { %>
          <p class="mensagem-erro"><%= erroPerfil %></p>
        <% } %>
        <form action="/api/usuarios/perfil" method="POST" novalidate>
          <input type="hidden" name="_csrf" value="<%= csrfToken %>">
          <div class="campo-formulario">
            <label for="perfil-nome">Nome completo</label>
            <input type="text" id="perfil-nome" name="nome" autocomplete="name" value="<%= usuario.name %>">
          </div>
          <div class="campo-formulario">
            <label for="perfil-email">E-mail</label>
            <input type="email" id="perfil-email" name="email" autocomplete="email" value="<%= usuario.email %>">
          </div>
          <div class="campo-formulario">
            <label for="perfil-telefone">Telefone</label>
            <input type="tel" id="perfil-telefone" name="telefone" autocomplete="tel" value="<%= usuario.phone || '' %>">
          </div>
          <button type="submit" class="botao botao--primario">Salvar alterações</button>
        </form>
      </section>

      <section id="seguranca" class="cartao-perfurado" style="margin-bottom: 2rem;">
        <h2 style="font-size: 1.1rem;">Alterar senha</h2>
        <% if (typeof erroSenha !== 'undefined' && erroSenha) { %>
          <p class="mensagem-erro"><%= erroSenha %></p>
        <% } %>
        <form action="/api/usuarios/senha" method="POST" novalidate>
          <input type="hidden" name="_csrf" value="<%= csrfToken %>">
          <div class="campo-formulario">
            <label for="senha-atual">Senha atual</label>
            <input type="password" id="senha-atual" name="senhaAtual" autocomplete="current-password" required>
          </div>
          <div class="campo-formulario">
            <label for="nova-senha">Nova senha</label>
            <input type="password" id="nova-senha" name="novaSenha" autocomplete="new-password" minlength="8" required>
          </div>
          <button type="submit" class="botao botao--secundario">Atualizar senha</button>
        </form>
      </section>

      <section id="pedidos" class="cartao-perfurado">
        <h2 style="font-size: 1.1rem;">Meus pedidos</h2>
        <p style="color: var(--cor-tinta-suave); margin-bottom: 0;">
          Histórico de pedidos será exibido aqui assim que o módulo de
          pedidos for implementado.
        </p>
      </section>
    </div>
  </div>
</section>

<script src="<%= asset('/js/perfil.js') %>"></script>

<%- include('partials/footer') %>
