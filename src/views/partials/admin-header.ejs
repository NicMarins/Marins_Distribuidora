<!DOCTYPE html>
<html lang="pt-BR">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title><%= titulo %> | Painel Administrativo</title>
  <meta name="robots" content="noindex, nofollow">
  <link rel="icon" type="image/svg+xml" href="/images/favicon.svg">
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link href="https://fonts.googleapis.com/css2?family=Archivo+Black&family=Work+Sans:wght@400;500;600;700&family=IBM+Plex+Mono:wght@400;500&display=swap" rel="stylesheet">
  <link rel="stylesheet" href="<%= asset('/css/style.css') %>">
  <link rel="stylesheet" href="<%= asset('/css/admin.css') %>">
  <script src="<%= asset('/js/csrf.js') %>"></script>
</head>
<body>
  <div class="admin-layout">
    <aside class="admin-sidebar">
      <a href="/admin" class="marca" style="margin-bottom: 2rem; display: flex;">
        Descarte<span class="marca__selo">ADMIN</span>
      </a>
      <nav aria-label="Navegação administrativa">
        <ul class="admin-menu">
          <li><a href="/admin" class="<%= rotaAtual === '/admin' ? 'admin-menu__ativo' : '' %>">Visão geral</a></li>
          <li><a href="/admin/produtos" class="<%= rotaAtual.startsWith('/admin/produtos') ? 'admin-menu__ativo' : '' %>">Produtos</a></li>
          <li><a href="/admin/categorias" class="<%= rotaAtual === '/admin/categorias' ? 'admin-menu__ativo' : '' %>">Categorias</a></li>
          <li><a href="/admin/usuarios" class="<%= rotaAtual === '/admin/usuarios' ? 'admin-menu__ativo' : '' %>">Usuários</a></li>
          <li><a href="/admin/contatos" class="<%= rotaAtual === '/admin/contatos' ? 'admin-menu__ativo' : '' %>">Contatos recebidos</a></li>
          <li><a href="/admin/configuracoes" class="<%= rotaAtual === '/admin/configuracoes' ? 'admin-menu__ativo' : '' %>">Configurações do site</a></li>
        </ul>
      </nav>
      <a href="/" class="link-discreto" style="margin-top: auto;">← Voltar para o site</a>
    </aside>

    <div class="admin-conteudo">
      <header class="admin-topo">
        <h1><%= titulo %></h1>
        <div class="admin-topo__usuario">Olá, <%= usuarioAtual ? usuarioAtual.nome : 'Administrador' %></div>
      </header>

      <main class="admin-main">
