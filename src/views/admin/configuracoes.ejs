<%- include('../partials/admin-header') %>

<section class="admin-secao form-admin">
  <% if (salvo) { %>
    <p class="mensagem-sucesso">Configurações salvas com sucesso.</p>
  <% } %>

  <form action="/admin/configuracoes" method="POST">
    <input type="hidden" name="_csrf" value="<%= csrfToken %>">
    <div class="campo-formulario">
      <label for="site-nome">Nome da loja</label>
      <input type="text" id="site-nome" name="site_nome" value="<%= configuracoes.site_nome || '' %>" required>
    </div>

    <div class="campo-formulario">
      <label for="site-whatsapp">WhatsApp (apenas números, com DDI e DDD)</label>
      <input type="text" id="site-whatsapp" name="site_whatsapp" value="<%= configuracoes.site_whatsapp || '' %>" placeholder="5511999999999">
      <span class="dica-campo">Usado no botão "Conversar no WhatsApp" da página de Contato.</span>
    </div>

    <div class="campo-formulario">
      <label for="site-email">E-mail de contato</label>
      <input type="email" id="site-email" name="site_email" value="<%= configuracoes.site_email || '' %>">
    </div>

    <div class="grade-form-2col">
      <div class="campo-formulario">
        <label for="site-instagram">Link do Instagram</label>
        <input type="url" id="site-instagram" name="site_instagram" value="<%= configuracoes.site_instagram || '' %>">
      </div>
      <div class="campo-formulario">
        <label for="site-facebook">Link do Facebook</label>
        <input type="url" id="site-facebook" name="site_facebook" value="<%= configuracoes.site_facebook || '' %>">
      </div>
    </div>

    <button type="submit" class="botao botao--primario">Salvar configurações</button>
  </form>
</section>

<%- include('../partials/admin-footer') %>
