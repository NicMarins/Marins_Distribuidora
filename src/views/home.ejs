<%- include('partials/header') %>

<section class="hero">
  <div class="container">
    <span class="hero__etiqueta">SEJA BEM-VINDO(A)À MARINS DISTRIBUIDORA</span>
    <h1 class="hero__titulo">Descartáveis, Panos, Higiene e outros somente aqui, peça já!</h1>
    <p class="hero__descricao">
      Se você é revendedor ou lojista, conheça nosso catálogo de produtos e faça seu pedido.
    </p>
    <div class="hero__acoes">
      <a href="/catalogo" class="botao botao--primario">Ver catálogo</a>
      <a href="/sobre" class="botao botao--secundario">Conhecer a empresa</a>
    </div>
  </div>
</section>

<section class="container" style="padding: 3rem 0;">
  <h2>Produtos em destaque</h2>
  <div class="grade-produtos">
    <% destaques.forEach(produto => { %>
      <%- include('partials/cartao-produto', { produto }) %>
    <% }) %>
  </div>
</section>

<section class="container" style="padding: 0 0 3rem;">
  <div class="cartao-perfurado">
    <h2 style="font-size: 1.2rem;">Acesse a página catalogo e confira todos os produtos disponíveis para compra.
    </h2>
    <p style="color: var(--cor-tinta-suave); margin-bottom: 0;">
      Entre em contato conosco para mais informações sobre os produtos, preços e condições de compra. Estamos à disposição para atender suas necessidades e oferecer soluções personalizadas.
    </p>
  </div>
</section>

<%- include('partials/footer') %>
